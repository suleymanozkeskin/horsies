{
  "name": "horsies-native-bridge",
  "private": true,
  "type": "module",
  "scripts": {
    "build:dev": "napi build --platform --esm",
    "test:native": "cd .. && bun test --path-ignore-patterns='node_modules/**' tests/runtime/native/",
    "test:native:node": "cd .. && node --test 'tests/runtime/native/**/*.test.ts'"
  },
  "napi": {
    "binaryName": "horsies",
    "packageName": "@horsies/native",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "aarch64-apple-darwin"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.12"
  }
}
