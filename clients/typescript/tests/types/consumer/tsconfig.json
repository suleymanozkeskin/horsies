{
  // The project of a user of the package. The type-test runner copies it into a work folder whose node_modules holds
  // the built package (horsies) and zod, then compiles it with each compiler of both lanes. No skipLibCheck: the
  // published declarations are checked too.
  "compilerOptions": {
    "target": "es2025",
    "module": "nodenext",
    // The Temporal types: the published declarations hold no lib reference to them yet (#2427).
    "lib": ["es2025", "dom", "esnext.temporal"],
    "types": [],
    "strict": true,
    "skipLibCheck": false,
    "noEmit": true
  },
  "include": ["src"]
}
