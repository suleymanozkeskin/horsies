{
  "name": "@horsies/eslint-plugin",
  "private": true,
  "version": "0.8.1",
  "description": "ESLint rule for the horsies TypeScript client: an expression statement that drops a horsies Result is an error",
  "license": "MIT",
  "homepage": "https://suleymanozkeskin.github.io/horsies/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suleymanozkeskin/horsies.git",
    "directory": "clients/typescript/eslint-plugin"
  },
  "bugs": {
    "url": "https://github.com/suleymanozkeskin/horsies/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "node --test 'tests/**/*.test.ts'"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": ">=6.0.0 <6.1.0"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.72.2"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "8.72.2",
    "@typescript-eslint/rule-tester": "8.72.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.15.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
