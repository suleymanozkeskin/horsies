+async def _ensure_partition_coverage(dsn: str) -> None:
+    """The coverage pass of a worker's startup with the default retention
+    settings: classes, history and heartbeat leaves, published readers."""
+    retention = RetentionConfig()
+    engine = create_async_engine(dsn)
+    try:
+        async with engine.begin() as connection:
+            outcome = await ensure_partition_coverage(
+                connection,
+                history_horizon_days=retention.history_leaf_horizon_days,
+                heartbeat_horizon_hours=retention.heartbeat_leaf_horizon_hours,
+            )
+    finally:
