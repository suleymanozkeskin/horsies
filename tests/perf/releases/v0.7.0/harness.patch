+            raise ValueError(
+                f'a seeded row index runs from 1 to {MAX_SEEDED_INDEX}, got {index}'
+            )
+        return str(uuid.UUID(hex=f'{self.prefix}{index:0{ID_INDEX_HEX_DIGITS}x}'))
+
+    def ids(self, count: int) -> Iterator[str]:
