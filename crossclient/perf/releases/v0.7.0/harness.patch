+        RuntimeError: the read or the finish did not find the seeded task, or
+            the finish did not write its terminal failure.
+    """
+    retry = _retry_request(connection, task_id)
+    rows = (
+        connection.execute(
+            FINISH_FAILED_ATTEMPT_SQL,
+            _failed_attempt_parameters(task_id, retry),
+        )
+        .mappings()
+        .all()
+    )
+    if len(rows) != 1:
+        connection.rollback()
+        raise RuntimeError(f'failed attempt operation returned {len(rows)} rows')
+    match decode_failed_attempt_row(_mappings(rows)[0]):
+        case FailureApplied(retry=RetryNotRequested(), after=CapacityWoken()):
+            connection.commit()
+            return 1
+        case other:
+            connection.rollback()
+            raise RuntimeError(
+                f'failed attempt operation returned {other!r} for a seeded task'
+            )
 
 
